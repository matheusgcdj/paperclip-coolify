# ==============================================================================
# Paperclip - Configuração de Ambiente para Coolify / Docker Compose
# ==============================================================================
# Copie este arquivo para `.env` ou configure estas variáveis diretamente na aba
# "Environment Variables" da sua aplicação/serviço no Coolify.
#
# No Coolify, variáveis iniciadas com SERVICE_* são geradas automaticamente.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações Principais do Servidor
# ------------------------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=3100
SERVE_UI=true
PAPERCLIP_HOME=/paperclip

# Modo de deploy: "authenticated" (requer login de usuário) ou "local_trusted" (sem login)
PAPERCLIP_DEPLOYMENT_MODE=authenticated

# Exposição de rede: "public" (internet pública com TLS/domínio) ou "private" (LAN / Tailscale / VPN)
PAPERCLIP_DEPLOYMENT_EXPOSURE=public

# Modo de validação da URL pública no Better Auth ("explicit" exigido em modo público autenticado)
PAPERCLIP_AUTH_BASE_URL_MODE=explicit

# URL pública pela qual os usuários e agentes acessarão a interface Web
# No Coolify, preenchido automaticamente com ${SERVICE_URL_PAPERCLIP} ou o seu domínio FQDN (ex: https://paperclip.seudominio.com)
PAPERCLIP_PUBLIC_URL=http://localhost:3100

# Hostnames adicionais permitidos (separados por vírgula, ex: paperclip.internal,vpn.mydomain.com)
PAPERCLIP_ALLOWED_HOSTNAMES=

# Segredo criptográfico para assinatura de sessões (Better Auth).
# Obrigatório em produção. No Coolify, ${SERVICE_HEX_64_PAPERCLIP} gera automaticamente uma chave de 64 caracteres.
# Para gerar manualmente no terminal: openssl rand -hex 32
BETTER_AUTH_SECRET=

# ------------------------------------------------------------------------------
# 2. Banco de Dados PostgreSQL (Obrigatório em modo público autenticado)
# ------------------------------------------------------------------------------
# No Coolify, usando o stack com o container "postgres", as variáveis abaixo são auto-geradas:
POSTGRES_USER=paperclip
POSTGRES_PASSWORD=paperclip_secure_password
POSTGRES_DB=paperclip

# String de conexão completa usada pelo Paperclip:
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 3. Provedores de LLM e Adaptadores de Agentes
# ------------------------------------------------------------------------------
# Pelo menos uma chave de provedor deve ser informada para os agentes executarem tarefas.
# O container oficial do Paperclip já vem com as seguintes CLIs pré-instaladas:
# - Claude Code CLI (@anthropic-ai/claude-code)
# - OpenAI Codex CLI (@openai/codex)
# - OpenCode Multi-Provider (opencode-ai)
# - Google Gemini CLI (@google/gemini-cli)
# - Moonshot Kimi CLI (@moonshot-ai/kimi-code)

# Anthropic (Claude Code adapter - claude_local)
ANTHROPIC_API_KEY=
# URL customizada opcional para proxy Anthropic
ANTHROPIC_BASE_URL=

# OpenAI (Codex adapter - codex_local)
OPENAI_API_KEY=
# URL customizada para provedores compatíveis com OpenAI (ex: http://ollama:11434/v1, https://api.deepseek.com/v1, vLLM, LiteLLM, OneAPI)
OPENAI_BASE_URL=
# Modelos customizados exibidos no combo/dropdown de seleção do Paperclip (formato JSON)
PAPERCLIP_ADAPTER_MODELS='{"codex_local":[{"id":"gpt-4o","label":"GPT-4o (OmniRoute)"},{"id":"gpt-4o-mini","label":"GPT-4o Mini (OmniRoute)"},{"id":"claude-3-5-sonnet-20241022","label":"Claude 3.5 Sonnet (OmniRoute)"},{"id":"deepseek-chat","label":"DeepSeek V3 (OmniRoute)"},{"id":"deepseek-reasoner","label":"DeepSeek R1 (OmniRoute)"}]}'

# OpenRouter (Acesso a centenas de modelos com chave única: DeepSeek, Llama 3, Claude, etc.)
OPENROUTER_API_KEY=

# Google Gemini (Gemini adapter - gemini_local)
# Nota: A Google exige chaves restritas à Gemini API para uso com o CLI
GEMINI_API_KEY=
# Desativa tentativa de Docker-in-Docker da CLI do Gemini dentro do container
GEMINI_SANDBOX=false

# Moonshot AI (Kimi Code adapter - kimi_local)
MOONSHOT_API_KEY=

# xAI Grok (Grok adapter - grok_local)
XAI_API_KEY=

# Cursor Cloud / Local adapter
CURSOR_API_KEY=

# OpenCode: permite o uso de todos os modelos suportados pelo OpenCode CLI
OPENCODE_ALLOW_ALL_MODELS=true

# GitHub Personal Access Token (para automações de PRs, issues e repositórios pelos agentes)
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 4. Configurações Avançadas e Opcionais
# ------------------------------------------------------------------------------
# Chave mestra para criptografia do cofre de segredos do Paperclip (32 bytes em hex ou base64)
# Se não fornecido, o Paperclip gera automaticamente em /paperclip/instances/default/secrets/master.key
# PAPERCLIP_SECRETS_MASTER_KEY=

# URL pública específica para webhooks de chat (Discord, Slack, etc.) se diferente do painel principal
# PAPERCLIP_CHAT_WEBHOOK_PUBLIC_URL=

# URL pública WebSocket (wss://) para agentes executados em runners remotos (Paperclip Runner)
# PAPERCLIP_RUNNER_PUBLIC_URL=
